##
# Team-Übersicht als Inhaltselement, einsetzbar auf jeder Seite.
# Ohne gesetzten Abteilungsfilter werden alle Personen der Quelle gezeigt.
#
prototype(Waterproof.Team:Content.TeamGrid) < prototype(Neos.Neos:ContentComponent) {
    _headline = ${q(node).property('headline')}
    _columns = ${q(node).property('columns') || 'cols3'}
    # Referenzen über referenceNodes() lesen; property() greift dafür nur
    # über eine als deprecated markierte Rückfallebene.
    _source = ${q(node).referenceNodes('source').get(0)}
    _departments = ${q(node).referenceNodes('departmentFilter').get()}

    _index = ${this._source ? this._source : q(site).find('[instanceof Waterproof.Team:Document.TeamIndex]').get(0)}

    _allPersons = ${this._index
        ? q(this._index).children('[instanceof Waterproof.Team:Document.Person]').get()
        : []}

    # Gefiltert wird von der Taxonomie aus: backReferenceNodes liefert alle
    # Knoten, die auf die gewählten Abteilungen verweisen.
    #
    # Bewusst kein Array.filter mit Eel-Closure. Zwei Anläufe scheiterten:
    # 1. ${this._departmentIds} innerhalb der Closure löst nicht auf.
    # 2. Der Umweg über @context ebenfalls nicht, weil @context ausgewertet
    #    wird, bevor die Properties des Prototyps vorliegen — ${this.…} ist
    #    dort noch leer.
    # Beide Male war das Prädikat immer wahr und der Filter stillschweigend
    # wirkungslos; die Liste sah dabei vollständig und plausibel aus.
    # Kontextvariablen aus dem Request funktionieren in Closures dagegen,
    # siehe den Kategoriefilter in Waterproof.News.
    _persons = ${Array.length(this._departments) > 0
        ? q(this._departments).backReferenceNodes('taxonomyReferences').filter('[instanceof Waterproof.Team:Document.Person]').get()
        : this._allPersons}

    renderer = afx`
        <section class="px-4 py-16">
            <div class="mx-auto max-w-7xl">
                <h2 class="mb-10 text-center text-3xl font-bold" @if.hasHeadline={props._headline}>
                    {props._headline}
                </h2>
                <Waterproof.Team:Component.PersonCollection
                    items={props._persons}
                    columns={props._columns}
                />
            </div>
        </section>
    `

    # Liest aus einem fremden Teilbaum, deshalb zusätzlich der Node-Typ-Tag:
    # er greift bei jeder Änderung an einer Person, unabhängig von ihrem Ort.
    @cache {
        mode = 'cached'
        entryIdentifier {
            node = ${Neos.Caching.entryIdentifierForNode(node)}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTag(node)}
            2 = ${Neos.Caching.nodeTypeTag('Waterproof.Team:Document.Person', documentNode)}
            # Ohne Quelle wird die erste Teamübersicht der Site gesucht.
            3 = ${Neos.Caching.nodeTypeTag('Waterproof.Team:Document.TeamIndex', documentNode)}
        }
    }
}

##
# Einzelne Person als Ansprechpartner-Block.
#
prototype(Waterproof.Team:Content.TeamHighlight) < prototype(Neos.Neos:ContentComponent) {
    _headline = ${q(node).property('headline')}
    _person = ${q(node).referenceNodes('person').get(0)}

    # Neos.Fusion:Renderer erwartet unter `renderer` ein Fusion-Objekt; ein
    # `type` kennt der Prototyp nicht. Deshalb steht der Block als
    # Fusion-Objekt statt in AFX.
    renderer = Neos.Fusion:Join {
        heading = Neos.Fusion:Component {
            _headline = ${q(node).property('headline')}
            renderer = afx`
                <h2 class="mb-6 text-2xl font-bold" @if.hasHeadline={props._headline}>
                    {props._headline}
                </h2>
            `
        }

        # @context wird vor @if ausgewertet: Innerhalb dieses Objekts zeigt
        # `node` bereits auf die Person. Eine Bedingung, die von der
        # Referenz des Inhaltsknotens abhängt, gehört deshalb an den Join.
        person = Waterproof.Team:Document.Person.Short {
            @context.node = ${q(node).referenceNodes('person').get(0)}
        }

        @process.wrap = ${'<section class="px-4 py-12"><div class="mx-auto max-w-3xl">' + value + '</div></section>'}
        @if.hasPerson = ${q(node).referenceNodes('person').get(0)}
    }

    @cache {
        mode = 'cached'
        entryIdentifier {
            node = ${Neos.Caching.entryIdentifierForNode(node)}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTag(node)}
            2 = ${Neos.Caching.nodeTypeTag('Waterproof.Team:Document.Person', documentNode)}
        }
    }
}
